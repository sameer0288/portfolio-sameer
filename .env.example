# ==============================================================================
# SAMEER ALI PORTFOLIO - ENVIRONMENT CONFIGURATION
# ==============================================================================
# The portfolio runs out-of-the-box in zero-cost offline mode without any keys.
# When OPENROUTER_API_KEY is omitted, the AI Assistant provides deterministic
# answers strictly grounded in the verified portfolio knowledge base.
# ==============================================================================

# AI Portfolio Assistant (OpenRouter)
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model ID to use on OpenRouter (default: free model)
# Free models currently available:
# - meta-llama/llama-3.3-70b-instruct:free
# - google/gemma-4-31b-it:free
# - nvidia/nemotron-3.5-lightning:free
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# (Optional) Email Delivery via SMTP (e.g. Gmail SMTP)
# Deliver direct transmission to: sameersheikh0288@gmail.com
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sameersheikh0288@gmail.com
SMTP_PASS=your_gmail_app_password_here

# (Optional) MongoDB Connection for message / telemetry persistence
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=

# Environment mode
NODE_ENV=development
